{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devmonitor-gateway-controller",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devmonitor-gateway",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "CORS_ORIGIN": "*"
  }
}
