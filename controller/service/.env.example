# Copy to .env for a local test deployment. Never commit real credentials.
DATABASE_URL=postgresql://controller_user:CHANGE_ME@localhost:5432/devmonitor_gateway
OIDC_ISSUER=https://YOUR_IDENTITY_PROVIDER/
OIDC_AUDIENCE=YOUR_APPLICATION_AUDIENCE
OIDC_JWKS_URL=https://YOUR_IDENTITY_PROVIDER/.well-known/jwks.json
DB_POOL_MAX_SIZE=10
